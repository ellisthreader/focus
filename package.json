{
  "name": "focus-personal-os",
  "version": "1.0.0",
  "private": true,
  "author": "Ellis Threader",
  "desktopName": "focus.desktop",
  "description": "A private local-first personal operating system for planning, focus, health, progress, and reflection.",
  "main": "main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/ellisthreader/focus.git"
  },
  "homepage": "https://github.com/ellisthreader/focus#readme",
  "bugs": {
    "url": "https://github.com/ellisthreader/focus/issues"
  },
  "keywords": [
    "electron",
    "productivity",
    "time-tracking",
    "local-first",
    "focus",
    "calendar",
    "tasks",
    "habits",
    "personal-dashboard"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "bash -c 'unset ELECTRON_RUN_AS_NODE; FOCUS_COMPAT_MODE=1 electron --no-sandbox --disable-setuid-sandbox .'",
    "start:compat": "npm start",
    "check": "node scripts/check.cjs",
    "verify": "npm run check && npm test",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "setup:mysql": "node scripts/setup-mysql.cjs",
    "screenshots": "node scripts/capture-screenshots.cjs",
    "test": "node --test focusModel.test.cjs test/*.test.mjs test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^41.7.0",
    "electron-builder": "^26.15.2"
  },
  "dependencies": {
    "mysql2": "^3.22.3"
  },
  "build": {
    "appId": "com.ellisthreader.focus",
    "productName": "Focus",
    "asar": true,
    "files": [
      "index.html",
      "main.cjs",
      "preload.cjs",
      "focusModel.js",
      "assistant-service.cjs",
      "local-assistant-service.cjs",
      "local-ai-runtime.cjs",
      "medical-vault.cjs",
      "nutrition-service.cjs",
      "pc-performance.cjs",
      "src/**/*",
      "package.json"
    ],
    "artifactName": "Focus-${version}-${os}-${arch}.${ext}",
    "linux": {
      "executableName": "focus",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
